# Supabase 配置
# 本地开发：npx supabase start 后会输出 URL 和 anon key
# 云端：在 https://supabase.com 的项目 Settings > API 中获取
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 豆包语音识别 ASR（服务端代理，不暴露给浏览器）
# 申请地址：https://www.volcengine.com/product/doubao （语音识别大模型）
DOUBAO_ASR_APPID=your-doubao-appid-here
DOUBAO_ASR_TOKEN=your-doubao-access-token-here
